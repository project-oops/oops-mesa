#!/usr/bin/env bash
# oops-mesa - the dev CLI for the Mesa shims. `oops check oops-mesa` runs the same `check`.
#
#   ./bin/oops-mesa check   pin, patches, documents, formatting, generated tool outputs
#   ./bin/oops-mesa fmt     format first-party C and C++ in place
#   ./bin/oops-mesa build   stage the sysroot, then configure and build Mesa in the container
#   ./bin/oops-mesa test    the shims' host suite
#   ./bin/oops-mesa clean   remove build output
set -euo pipefail

cd "$(dirname "$0")/.."

# The Mesa build runs in the toolchain container. The sysroot and sources are staged on the
# host first, because staging reads a checkout the container cannot see.
build() {
    local image
    image=$(sed -n 's/^TOOLCHAIN_IMAGE *:= *//p' dependencies.mk)

    command -v docker >/dev/null 2>&1 || {
        echo "oops-mesa: docker is not on PATH; the Mesa build only runs in its container" >&2
        exit 1
    }

    bash toolchain/stage-sysroot.sh
    bash toolchain/stage-sources.sh
    bash toolchain/stage-platform-stubs.sh

    if ! docker image inspect "$image" >/dev/null 2>&1; then
        echo "oops-mesa: building the toolchain image $image"
        docker build -t "$image" toolchain/
    fi

    # Git Bash rewrites Unix-looking arguments; `pwd -W` gives the path the Windows daemon mounts.
    local host_pwd
    host_pwd=$(pwd -W 2>/dev/null || pwd)

    MSYS_NO_PATHCONV=1 docker run --rm -v "$host_pwd:/w" -w /w "$image" bash toolchain/build-mesa.sh
}

usage() {
    sed -n '2,9p' "$0" | sed 's|^# \{0,1\}||'
    exit "${1:-0}"
}

cmd="${1:-check}"
shift || true
case "$cmd" in
    check) make check ;;
    fmt) bash tools/format.sh ;;
    clean) make clean ;;
    build) build ;;
    test) make test ;;
    -h | --help | help) usage ;;
    *)
        printf 'oops-mesa: unknown verb %s\n\n' "$cmd" >&2
        usage 1
        ;;
esac
