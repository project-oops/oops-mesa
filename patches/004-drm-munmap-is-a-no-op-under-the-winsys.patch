# 004-drm-munmap-is-a-no-op-under-the-winsys.patch
#
# What it changes
#   libdrm's drm_munmap is a no-op under OOPS_MESA_WINSYS, the counterpart of patch 001's
#   drm_mmap redirect. A buffer's CPU mapping belongs to the bo for its lifetime and is released
#   at GEM_CLOSE (oops_winsys_gem_close -> oops_mem_unmap), as oops_winsys_munmap already
#   assumes. A real munmap frees the address for reuse, so radeonsi's map/memcpy/unmap shader
#   upload (RADEON_MAP_TEMPORARY) lands in another buffer's pages.
#
# Why it could not be a shim
#   drm_munmap is a `static inline` function in libdrm's own header; there is no symbol to
#   interpose on.
--- a/subprojects/libdrm-2.4.133/libdrm_macros.h
+++ b/subprojects/libdrm-2.4.133/libdrm_macros.h
@@ -89,7 +89,19 @@ static inline int drm_munmap(void *addr, size_t length)
                  LARGE_OFF_T % 2147483647 == 1);
 #undef LARGE_OFF_T

-   return munmap(addr, length);
+#ifdef OOPS_MESA_WINSYS
+   /* No-op, and it is the other half of the drm_mmap redirect above. The shim owns a buffer's CPU
+    * mapping for the bo's lifetime and releases it only at GEM_CLOSE. radeonsi maps and unmaps
+    * buffers repeatedly (the RADEON_MAP_TEMPORARY shader upload does), and a real unmap here frees
+    * the virtual address; the platform then re-hands that same address to the next buffer, two bos
+    * collide on one CPU address, and a write to one lands in the other's pages - which is exactly
+    * what left the shader buffer empty and faulted the wavefronts (oops-mesa worklog 059). */
+   (void)addr;
+   (void)length;
+   return 0;
+#else
+   return munmap(addr, length);
+#endif
 }
 #endif

