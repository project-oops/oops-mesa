# Build output of the shims and of Mesa. Mesa's own tree is a submodule and is never built in
# place; the container build writes here.
build/
dist/

# Pinned C-library headers, copied in and verified against dependencies.mk; never tracked.
toolchain/sysroot/

# Upstream sources staged from the same pinned checkout (D005), carried through the build
# rather than kept here.
toolchain/libelf-src/
toolchain/libcxx-src/

# FreeBSD's msun (math library) and locale sources, staged the same way (D011).
toolchain/msun-src/
toolchain/locale-src/

# Editor and OS noise.
*.swp
.DS_Store
Thumbs.db
toolchain/platform-stubs.c
